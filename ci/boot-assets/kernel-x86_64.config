# x86_64 kernel config fragment for QEMU q35: an EFI stub kernel that GRUB
# boots from CrabEFI or SeaBIOS, with the TPM driver for the measured-boot
# guest.
#
# Applied on top of tinyconfig by default.nix.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_RELOCATABLE=y
CONFIG_X86_X2APIC=y

# Console
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EARLY_PRINTK=y

# Firmware interfaces
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PNP=y

# Initramfs and userspace
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# Filesystems
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SECURITYFS=y

# TPM 1.2 and 2.0 behind a TIS interface, and the banks the guest reads.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
