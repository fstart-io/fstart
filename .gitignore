**/target
*.rom
*.bin
*.ffs
*.key
!*.pub

# FIT build artifacts (kernel images, initramfs, compiled .itb)
*.itb
*.cpio
fit/Image-*
fit/zImage-*
fit/initramfs-*

# Board test artifacts (DTBs, kernel images, symlinks, disk images)
*.dtb
*.img
*.iso
*.qcow2
zImage
Image
bl31.bin
**/keys/**

# Tool/IDE artifacts
.opencode/

# Accidental media
*.jpeg
*.jpg
*.png
.pi-lens/

# Linux kernel build artifacts
bzImage

# CI payload/boot-test assets (built via `nix run .#ci-build-payloads`)
boot-assets/

# Board crates are not workspace members; their lockfiles are rust-analyzer/cargo-check artifacts.
# Real builds lock inside the fbuild temp workspace under target/.
boards/*/*/Cargo.lock
