**/target
*.rom
*.bin
# FFS test goldens are committed fixtures, not build outputs.
!crates/ffs/tests/fixtures/*.bin
*.ffs
*.key
!*.pub

# FIT build artifacts (kernel images, initramfs, compiled .itb)
*.itb
*.cpio

# Board test artifacts (DTBs, kernel images, symlinks, disk images)
*.dtb
*.img
*.iso
*.qcow2
zImage
Image
bl31.bin
**/keys/**

# Tool/IDE artifacts
__pycache__/
.opencode/
node_modules/
.wrangler/

# Accidental media
*.jpeg
*.jpg
*.png
!docs/logo.jpeg
.pi-lens/

# Linux kernel build artifacts
bzImage

# Boot-test assets (`nix build .#boot-assets`, or CI's copy)
/boot-assets/
/result

# Board crates are workspace members; per-board Cargo.lock files are stray
# artifacts from standalone cargo/rust-analyzer runs outside the workspace.
boards/*/*/Cargo.lock

# Vendor firmware inputs are supplied by the user, never committed.
boards/*/*/vendor/*
!boards/*/*/vendor/README.md
